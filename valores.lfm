<?xml version="1.0" encoding="UTF-8"?>
<form name="frmValores" title="Valores" width="880" height="640">
    <!-- ATRIBUTOS PRINCIPAIS -->
    <layout left="20" top="20" width="400" height="300">
        <label text="ATRIBUTOS" left="10" top="10" width="380" fontStyle="bold" fontSize="14"/>
        
        <!-- FORÇA -->
        <layout left="10" top="40" width="380" height="25">
            <label text="Força:" align="left" width="100" autoSize="true"/>
            <edit field="forca" align="client" horzTextAlign="center" width="50"/>
            <label field="modificadorForca" align="right" width="70" horzTextAlign="center"/>
        </layout>
        
        <!-- AGILIDADE -->
        <layout left="10" top="70" width="380" height="25">
            <label text="Agilidade:" align="left" width="100" autoSize="true"/>
            <edit field="agilidade" align="client" horzTextAlign="center" width="50"/>
            <label field="modificadorAgilidade" align="right" width="70" horzTextAlign="center"/>
        </layout>
    </layout>
</form>